# Copy to .env and fill in. .env is ignored by git and Docker.

# Snap (official Subquadratic API)
SUBQ_API_KEY=

# Neon AI gateway (Jev and OpenJev)
NEON_AI_GATEWAY_TOKEN=
NEON_AI_GATEWAY_BASE_URL=

# Neon Postgres results store. Needed for --store postgres and the Fly runner.
DATABASE_URL=

# Optional. Hard stop on budget-capped models, in dollars. Defaults to 45.
# SWB_BUDGET_CAP_USD=45
